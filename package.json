{
  "name": "antigravity-ide-workspace",
  "version": "1.0.0",
  "private": true,
  "description": "Antigravity IDE Master Governance Suite & Automation Engine",
  "scripts": {
    "validate:model-output": "ts-node tools/validate_model_output.ts docs/evaluations/production_remediation_output.json",
    "audit:model-output": "ts-node scripts/audit_model_output.ts docs/evaluations/production_remediation_output.json",
    "scan:transcript": "node scripts/scan_transcripts.js",
    "lint:tokens": "node tools/token_linter.js",
    "validate:tokens": "node tools/validate_tokens.js",
    "codemod:find-hex": "node tools/replace_hex_with_tokens.js --dry",
    "storybook": "start-storybook -p 6006 -s .",
    "build-storybook": "build-storybook -s .",
    "test:playwright": "playwright test",
    "test": "vitest --run",
    "guard": "node scripts/pre_deploy_guardian.js",
    "guard:mid": "node scripts/pre_deploy_guardian.js && echo '\n✅ Mid-point check passed.'",
    "remediate": "node scripts/run_production_remediation_agent.js",
    "preflight": "node scripts/run_production_remediation_agent.js && node scripts/pre_deploy_guardian.js"
  },
  "dependencies": {},
  "devDependencies": {
    "@axe-core/playwright": "^4.4.0",
    "@storybook/html": "^7.0.0",
    "@types/supertest": "^2.0.12",
    "acorn": "^8.10.0",
    "ajv": "^8.12.0",
    "eslint": "^8.45.0",
    "glob": "^8.1.0",
    "playwright": "^1.36.0",
    "supertest": "^6.3.3",
    "ts-node": "^10.9.1",
    "typescript": "^5.8.4",
    "vitest": "^1.3.0",
    "yaml": "^2.2.1",
    "zod": "^3.22.4"
  }
}
