<!DOCTYPE html>

<html class="dark" lang="en">
<head>
<meta charset="utf-8"/>
<meta content="width=device-width, initial-scale=1.0" name="viewport"/>
<title>Gatz | Autonomous AI-Augmented Solo Developer &amp; Systems Studio</title>
<!-- Stitch Design Token Metadata -->
<meta content="Variation B: Midnight Logic &amp; Ethereal Precision" name="stitch-design-system"/>
<meta content="AQ.Ab8RN6L50Nw4udYMY3W17UbZ3zW7h4AsJfQoPQW5F0mu-Pmy1w" name="stitch-api-key"/>
<!-- Tailwind CSS CDN with plugins -->
<script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
<!-- Google Fonts & Material Symbols -->
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@100..900&amp;family=JetBrains+Mono:wght@400;500;700&amp;family=Space+Grotesk:wght@500;700&amp;family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet"/>
<script id="tailwind-config">
    tailwind.config = {
      darkMode: "class",
      theme: {
        extend: {
          colors: {
            "surface-deep": "#050811",
            "surface-card": "#0B1C30",
            "outline-variant": "#1E293B",
            "accent-electric": "#2563EB",
            "accent-cyan": "#00E5FF",
            "accent-emerald": "#10B981",
            "accent-amber": "#F59E0B",
            "on-surface-variant": "#94A3B8"
          },
          fontFamily: {
            "body": ["Inter", "sans-serif"],
            "mono": ["JetBrains Mono", "monospace"],
            "display": ["Space Grotesk", "sans-serif"]
          }
        },
      },
    }
  </script>
<style>
    @property --border-angle {
      syntax: '<angle>';
      initial-value: 0deg;
      inherits: false;
    }

    @keyframes rotateBorder {
      0% { --border-angle: 0deg; }
      100% { --border-angle: 360deg; }
    }

    body {
      background-color: #050811;
      color: #dfe2f0;
      overflow-x: hidden;
      font-family: 'Inter', sans-serif;
    }

    /* Glassmorphic Cards */
    .glass-card {
      background: rgba(11, 28, 48, 0.85);
      backdrop-filter: blur(16px);
      border: 1px solid #1E293B;
      transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }
    .glass-card:hover {
      border-color: #2563EB;
      transform: translateY(-3px);
      box-shadow: 0 12px 30px -10px rgba(37, 99, 235, 0.25);
    }

    /* OFFICIAL STITCH MCP 2PX MOVING BORDER LINE ONLY (EXACT LOGIN PAGE PARITY) */
    .moving-border-card {
      position: relative;
      border-radius: 1.5rem;
      padding: 2px;
      background: conic-gradient(from var(--border-angle, 0deg), #2563EB, #00E5FF, #10B981, #F59E0B, #E11D48, #2563EB);
      animation: rotateBorder 4s linear infinite;
      isolation: isolate;
      box-shadow: 0 10px 35px -5px rgba(0, 229, 255, 0.35);
    }

    .moving-border-card::after {
      content: "";
      position: absolute;
      inset: -12px;
      border-radius: 2rem;
      background: conic-gradient(from var(--border-angle, 0deg), #2563EB, #00E5FF, #10B981, #F59E0B, #E11D48, #2563EB);
      animation: rotateBorder 4s linear infinite;
      z-index: -1;
      filter: blur(28px);
      opacity: 1;
      pointer-events: none;
    }

    /* STATIC CLEAN BUTTON (TEMP RESET TO ISOLATE CONFLICT) */
    .moving-border-btn {
      position: relative;
      border-radius: 0.85rem;
      background-color: #0B1C30 !important;
      border: 1px solid #2563EB !important;
    }
    .moving-border-btn::before,
    .moving-border-btn::after {
      content: none !important;
      display: none !important;
    }

    /* OPTION A: INTERACTIVE MOUSE SPOTLIGHT OVERLAY */
    .spotlight-card {
      position: relative;
      overflow: hidden;
    }

    .spotlight-card::after {
      content: '';
      position: absolute;
      inset: 0;
      background: radial-gradient(450px circle at var(--mouse-x, 50%) var(--mouse-y, 50%), rgba(0, 229, 255, 0.14), transparent 75%);
      opacity: 0;
      transition: opacity 0.25s ease;
      pointer-events: none;
      z-index: 5;
    }

    .spotlight-card:hover::after {
      opacity: 1;
    }

    .material-symbols-outlined {
      font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
    }

    /* Toast animation */
    @keyframes slideIn {
      from { transform: translateY(100%); opacity: 0; }
      to { transform: translateY(0); opacity: 1; }
    }
    .animate-slide-in {
      animation: slideIn 0.3s ease-out forwards;
    }

    /* Custom scrollbar for horizontal screenshot preview rows */
    .no-scrollbar::-webkit-scrollbar {
      display: none;
    }
    .no-scrollbar {
      -ms-overflow-style: none;
      scrollbar-width: none;
    }
  </style>
</head>
<body class="font-body text-base antialiased selection:bg-blue-500 selection:text-white">
