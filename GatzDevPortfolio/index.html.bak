<!-- COL 1: SPECS (Span 2) -->
<div class="xl:col-span-2 flex flex-col gap-2 bg-[#0B1C30]/30 p-3 rounded-xl border border-slate-800/80">
<div class="font-mono text-[10px] text-accent-electric uppercase tracking-widest mb-2 border-b border-slate-800 pb-2">Full Specs &amp; Integrations</div>
<div class="flex items-start gap-2 bg-surface-card/40 p-2 rounded-lg border border-outline-variant hover:border-accent-electric transition-colors">
