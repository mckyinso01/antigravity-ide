<!-- JAVASCRIPT UX HANDLERS & MOUSE SPOTLIGHT CONTROLLER -->
<script>
    // OPTION A: Dynamic Mouse Spotlight Tracking Handler
    document.addEventListener('DOMContentLoaded', () => {
      // Initialize Full Container "Raindrops of the Soul" Canvas Animation Engine
      initSoulRainAnimation();

      const spotlightCards = document.querySelectorAll('.spotlight-card');

      spotlightCards.forEach(card => {
        card.addEventListener('mousemove', (e) => {
          const rect = card.getBoundingClientRect();
          const x = e.clientX - rect.left;
          const y = e.clientY - rect.top;
          card.style.setProperty('--mouse-x', `${x}px`);
          card.style.setProperty('--mouse-y', `${y}px`);
        });
      });

      // ARCH-01: Deep URL Hash Routing Check on Load
      checkUrlHashRouting();
    });

    // FE-01: Global Keyboard Event Listeners (Escape key & Ctrl+K)
    document.addEventListener('keydown', (e) => {
      // Escape key closes modals
      if (e.key === 'Escape') {
        closeModal('app-modal');
        closeModal('feature-modal');
        closeModal('contact-modal');
        closeModal('resume-modal');
      }
      
      // Ctrl+K or / key focuses Search Input
      if ((e.ctrlKey && e.key === 'k') || (e.key === '/' && document.activeElement.tagName !== 'INPUT' && document.activeElement.tagName !== 'TEXTAREA')) {
        e.preventDefault();
        const searchInput = document.getElementById('app-search-input');
        if (searchInput) searchInput.focus();
      }
    });

    // ARCH-01: Deep Hash Link Handler
    function checkUrlHashRouting() {
      const hash = window.location.hash.toLowerCase();
      if (hash.includes('omnistock')) {
        launchAppPreview('OmniStock POS', 'Autonomous Inventory & POS Telemetry Suite with barcode scanning, stock adjustment, and checkout terminal.', 'http://localhost:5174');
      } else if (hash.includes('ems')) {
        launchAppPreview('EMS Enterprise', 'Workforce & Emergency Medical Services Dispatch Command Suite with biometrics and shift scheduling.', 'http://localhost:5175');
      } else if (hash.includes('pulse')) {
        launchAppPreview('LeadSuite Pro', 'Autonomous CRM & High-Throughput Lead Pipeline Engine with real-time lead analytics.', 'http://localhost:5176');
      } else if (hash.includes('lexai')) {
        launchAppPreview('LexAI Enterprise', 'AI Legal Discovery & Contract Risk Audit Suite with contract scanning and risk flags.', 'http://localhost:5177');
      }
    }

    // Standalone Apps Category Filtering & Search Handler
    function filterCategory(cat) {
      const items = document.querySelectorAll('.product-card-item');
      const buttons = {
        all: document.getElementById('filter-btn-all'),
        pos: document.getElementById('filter-btn-pos'),
        dispatch: document.getElementById('filter-btn-dispatch'),
        crm: document.getElementById('filter-btn-crm'),
        legal: document.getElementById('filter-btn-legal')
      };

      Object.keys(buttons).forEach(key => {
        if (buttons[key]) {
          if (key === cat) {
            buttons[key].className = "px-4 py-2 rounded-xl border border-accent-electric bg-accent-electric text-white font-bold transition-all shadow-md";
          } else {
            buttons[key].className = "px-4 py-2 rounded-xl border border-outline-variant bg-slate-950/80 text-on-surface-variant hover:text-white transition-all";
          }
        }
      });

      items.forEach(item => {
        const itemCat = item.getAttribute('data-category');
        if (cat === 'all' || itemCat === cat) {
          item.classList.remove('hidden');
        } else {
          item.classList.add('hidden');
        }
      });
    }

    function handleSearchInput() {
      const query = document.getElementById('app-search-input').value.toLowerCase().trim();
      const items = document.querySelectorAll('.product-card-item');

      items.forEach(item => {
        const searchTags = item.getAttribute('data-search').toLowerCase();
        if (query === '' || searchTags.includes(query)) {
          item.classList.remove('hidden');
        } else {
          item.classList.add('hidden');
        }
      });
    }

    // Interactive Agency Cost Savings Calculator Handler
    function updateCalculator() {
      const val = parseInt(document.getElementById('team-scope-slider').value);
      const label = document.getElementById('slider-module-label');
      const agencyCost = document.getElementById('calc-agency-cost');
      const gatzCost = document.getElementById('calc-gatz-cost');
      const savings = document.getElementById('calc-savings');

      const agencyPrices = [15000, 30000, 60000, 90000, 150000];
      const gatzPrices = [2500, 5000, 10000, 15000, 20000];

      const curAgency = agencyPrices[val - 1];
      const curGatz = gatzPrices[val - 1];
      const netSavings = curAgency - curGatz;
      const pctSaved = Math.round((netSavings / curAgency) * 100);

      label.innerText = `${val} Standalone Module${val > 1 ? 's' : ''}`;
      agencyCost.innerText = `$${curAgency.toLocaleString()}`;
      gatzCost.innerText = `$${curGatz.toLocaleString()}`;
      savings.innerText = `$${netSavings.toLocaleString()} (${pctSaved}% SAVED!)`;
    }

    // SEC-01: Contact Form Live Email Validator
    function validateContactEmail() {
      const val = document.getElementById('contact-email-input').value;
      const badge = document.getElementById('email-valid-badge');
      if (val.includes('@') && val.includes('.')) {
        badge.classList.remove('hidden');
      } else {
        badge.classList.add('hidden');
      }
    }

    // Toast Notification System
    function showToast(message, type = 'info') {
      const container = document.getElementById('toast-container');
      const toast = document.createElement('div');
      
      const iconMap = { success: 'check_circle', info: 'info', warning: 'warning' };
      const colorMap = {
        success: 'border-emerald-500/40 bg-emerald-950/90 text-emerald-300',
        info: 'border-blue-500/40 bg-blue-950/90 text-blue-300',
        warning: 'border-amber-500/40 bg-amber-950/90 text-amber-300'
      };

      toast.className = `p-4 rounded-xl border backdrop-blur-xl shadow-2xl flex items-center gap-3 text-sm font-mono pointer-events-auto animate-slide-in ${colorMap[type] || colorMap.info}`;
      toast.innerHTML = `
        <span class="material-symbols-outlined text-xl">${iconMap[type] || 'info'}</span>
        <span class="flex-1">${message}</span>
        <button onclick="this.parentElement.remove()" class="opacity-60 hover:opacity-100">
          <span class="material-symbols-outlined text-sm">close</span>
        </button>
      `;

      container.appendChild(toast);
      setTimeout(() => { if (toast.parentElement) toast.remove(); }, 4000);
    }

    function closeModal(id) { document.getElementById(id).classList.add('hidden'); }

    function openFeatureModal(appName, featureTitle, featureDesc) {
      document.getElementById('feature-app-tag').innerText = appName;
      document.getElementById('feature-modal-title').innerText = featureTitle;
      document.getElementById('feature-modal-desc').innerText = featureDesc;
      document.getElementById('feature-mock-url').innerText = `${appName.toLowerCase().replace(/[^a-z]/g,'')}.internal/${featureTitle.toLowerCase().replace(/[^a-z]/g,'-')}`;
      document.getElementById('feature-modal').classList.remove('hidden');
    }

    let currentActiveLaunchUrl = 'http://localhost:5174';

    function launchAppPreview(title, desc, url) {
      currentActiveLaunchUrl = url || 'http://localhost:5174';
      document.getElementById('app-modal-title').innerText = title;
      document.getElementById('app-modal-desc').innerText = desc;
      document.getElementById('app-modal-url').innerText = currentActiveLaunchUrl;
      const iframe = document.getElementById('app-modal-iframe');
      if (iframe) {
        iframe.src = currentActiveLaunchUrl;
      }
      document.getElementById('app-modal').classList.remove('hidden');
    }

    function triggerAppLaunchToast() {
      closeModal('app-modal');
      showToast(`Launching ${document.getElementById('app-modal-title').innerText}...`, 'success');
      if (currentActiveLaunchUrl) {
        window.open(currentActiveLaunchUrl, '_blank');
      }
    }

    function openResumeModal() { document.getElementById('resume-modal').classList.remove('hidden'); }
    function downloadResumeToast() { closeModal('resume-modal'); showToast('Developer Profile download initiated.', 'success'); }
    
    function openContactModal(packageContext = '') { 
      if (packageContext) {
        document.getElementById('contact-modal-title').innerText = `Inquire: ${packageContext}`;
      } else {
        document.getElementById('contact-modal-title').innerText = 'Get In Touch';
      }
      document.getElementById('contact-modal').classList.remove('hidden'); 
    }

    function handleContactSubmit(e) {
      e.preventDefault();
      closeModal('contact-modal');
      showToast('Thank you! Your project message has been submitted to Gatz.', 'success');
    }

    // FULL CONTAINER BACKGROUND ANIMATION ENGINE: "Raindrops of the Soul" (Raindrop -> Splash -> Ascending Soul)
    function initSoulRainAnimation() {
      const canvas = document.getElementById('soul-rain-canvas');
      if (!canvas) return;
      const ctx = canvas.getContext('2d');

      let width = canvas.width = window.innerWidth;
      let height = canvas.height = window.innerHeight;

      window.addEventListener('resize', () => {
        width = canvas.width = window.innerWidth;
        height = canvas.height = window.innerHeight;
      });

      const raindrops = [];
      const splashes = [];
      const souls = [];

      const MAX_RAINDROPS = 28;

      class Raindrop {
        constructor() {
          this.reset();
        }
        reset() {
          this.x = Math.random() * width;
          this.y = -20 - Math.random() * 80;
          this.speed = 4.5 + Math.random() * 4.5;
          this.length = 10 + Math.random() * 14;
          this.opacity = 0.35 + Math.random() * 0.45;
          this.impactY = height * (0.85 + Math.random() * 0.12);
        }
        update() {
          this.y += this.speed;
          if (this.y >= this.impactY) {
            // Trigger Splash ring
            splashes.push(new Splash(this.x, this.impactY));
            // Trigger Ascending Soul particle
            souls.push(new Soul(this.x, this.impactY));
            this.reset();
          }
        }
        draw() {
          ctx.beginPath();
          ctx.strokeStyle = `rgba(0, 229, 255, ${this.opacity})`;
          ctx.lineWidth = 1.2;
          ctx.moveTo(this.x, this.y);
          ctx.lineTo(this.x, this.y - this.length);
          ctx.stroke();
        }
      }

      class Splash {
        constructor(x, y) {
          this.x = x;
          this.y = y;
          this.radius = 1;
          this.maxRadius = 14 + Math.random() * 10;
          this.opacity = 0.75;
          this.speed = 0.9;
        }
        update() {
          this.radius += this.speed;
          this.opacity -= 0.035;
        }
        draw() {
          if (this.opacity <= 0) return;
          ctx.beginPath();
          ctx.arc(this.x, this.y, this.radius, 0, Math.PI * 2);
          ctx.strokeStyle = `rgba(37, 99, 235, ${this.opacity})`;
          ctx.lineWidth = 1;
          ctx.stroke();
        }
      }

      class Soul {
        constructor(x, y) {
          this.x = x;
          this.y = y;
          this.speedY = 0.7 + Math.random() * 0.9;
          this.opacity = 0.8;
          this.size = 2 + Math.random() * 2.5;
          this.swayOffset = Math.random() * 100;
          this.colorType = Math.random();
        }
        update() {
          this.y -= this.speedY;
          this.swayOffset += 0.025;
          this.x += Math.sin(this.swayOffset) * 0.55;
          this.opacity -= 0.005;
        }
        draw() {
          if (this.opacity <= 0) return;
          ctx.beginPath();
          ctx.arc(this.x, this.y, this.size, 0, Math.PI * 2);
          
          let glowColor = `rgba(0, 229, 255, ${this.opacity})`;
          if (this.colorType > 0.66) {
            glowColor = `rgba(245, 158, 11, ${this.opacity})`; // Amber soul
          } else if (this.colorType > 0.33) {
            glowColor = `rgba(16, 185, 129, ${this.opacity})`; // Emerald soul
          }

          ctx.fillStyle = glowColor;
          ctx.shadowBlur = 8;
          ctx.shadowColor = glowColor;
          ctx.fill();
          ctx.shadowBlur = 0;
        }
      }

      for (let i = 0; i < MAX_RAINDROPS; i++) {
        raindrops.push(new Raindrop());
      }

      function animate() {
        ctx.clearRect(0, 0, width, height);

        raindrops.forEach(drop => {
          drop.update();
          drop.draw();
        });

        for (let i = splashes.length - 1; i >= 0; i--) {
          splashes[i].update();
          splashes[i].draw();
          if (splashes[i].opacity <= 0) {
            splashes.splice(i, 1);
          }
        }

        for (let i = souls.length - 1; i >= 0; i--) {
          souls[i].update();
          souls[i].draw();
          if (souls[i].opacity <= 0 || souls[i].y <= 0) {
            souls.splice(i, 1);
          }
        }

        requestAnimationFrame(animate);
      }

      animate();
    }
  </script>
</body>
</html>
