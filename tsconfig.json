{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "checkJs": false,
    "skipLibCheck": true,
    "allowJs": true,
    "noEmit": true,
    "outDir": "./dist"
  },
  "exclude": [
    "**/node_modules/**",
    "node_modules",
    "**/dist/**",
    "extensions",
    "**/extensions/**",
    "extensions/**/*"
  ]
}
