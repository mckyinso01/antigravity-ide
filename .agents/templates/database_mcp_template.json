{
  "mcpServers": {
    "postgres": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-postgres",
        "postgresql://username:password@localhost/mydb"
      ]
    },
    "mysql": {
      "command": "npx",
      "args": [
        "-y",
        "mcp-server-mysql",
        "mysql://username:password@localhost:3306/mydb"
      ]
    }
  }
}
